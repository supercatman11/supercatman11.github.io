# --- サプライチェーン対策 ---
# パッケージの install/postinstall スクリプトを実行しない。
# npm を経由したマルウェア(Shai-Hulud 等)の主な侵入経路を遮断する。
# Astro / esbuild / sharp はプリビルド済みバイナリを optionalDependencies で配布しているため、この設定でも動作する。
ignore-scripts=true

# バージョンを常に完全固定で保存する(^ や ~ を付けない)。更新は Dependabot 経由で行う。
save-exact=true

# package.json の engines と一致しない Node/npm では失敗させる
engine-strict=true

# インストール時に脆弱性監査を実施する
audit=true

# 寄付メッセージなどのノイズを抑制
fund=false
update-notifier=false
