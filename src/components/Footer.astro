---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>&copy; {year} {profile.name}</p>
    <ul class="links">
      {profile.links.map((l) => (
        <li><a href={l.href} rel="me noopener noreferrer" target="_blank">{l.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }
  .inner p {
    margin: 0;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
</style>
