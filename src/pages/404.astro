---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="ページが見つかりません" description="お探しのページは存在しません。">
  <section class="notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>ページが見つかりません</h1>
      <p>URL が間違っているか、ページが移動または削除された可能性があります。</p>
      <a class="button button--primary" href={withBase('/')}>トップへ戻る</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: clamp(4rem, 12vw, 8rem) 0;
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1;
  }
  .notfound p {
    color: var(--fg-muted);
  }
</style>
